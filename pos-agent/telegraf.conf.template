# ===========================================================================
# US Pizza POS Uptime Monitor — Telegraf agent for one POS terminal
# Outlet: {{OUTLET_CODE}} {{OUTLET_NAME}}
#
# Every minute: checks the POS app is running and pings the outlet's KDS/kiosk.
# Sends only when something CHANGED, plus an "I'm alive" refresh every 5 min.
# ===========================================================================

[global_tags]
  outlet_code = "{{OUTLET_CODE}}"
  pos_station = "{{POS_STATION}}"

[agent]
  interval = "1m"
  round_interval = true
  flush_interval = "1m"
  flush_jitter = "5s"
  metric_batch_size = 100
  metric_buffer_limit = 1000
  omit_hostname = false
  logfile = "C:\\Program Files\\InfluxData\\telegraf\\telegraf.log"
  logfile_rotation_max_size = "5MB"
  logfile_rotation_max_archives = 2
  skip_processors_after_aggregators = true

# ---------------------------------------------------------------------------
# "I'm alive": a stable value, so after dedup it is only re-sent every 5 min
# ---------------------------------------------------------------------------
[[inputs.mem]]
  fieldinclude = ["total"]

# ---------------------------------------------------------------------------
# Is the POS app running?  procstat_lookup.running = number of processes (0 = down)
# Fill in the process name from Task Manager → Details (e.g. "PosApp.exe")
# ---------------------------------------------------------------------------
{{PROCSTAT_BLOCK}}

# ---------------------------------------------------------------------------
# Peer devices on the outlet LAN (KDS / kiosk are Android, so the POS checks them)
# ---------------------------------------------------------------------------
{{PING_BLOCKS}}

# Only pass values that changed; re-send unchanged values every 5 minutes
[[processors.dedup]]
  dedup_interval = "5m"

# ---------------------------------------------------------------------------
# Send to the US Pizza dashboard
# ---------------------------------------------------------------------------
[[outputs.http]]
  url = "{{DASHBOARD_URL}}/api/heartbeat"
  method = "POST"
  timeout = "10s"
  data_format = "json"
  use_batch_format = true
  json_timestamp_units = "1s"
  [outputs.http.headers]
    Content-Type = "application/json"
    Authorization = "Bearer {{TOKEN}}"
