# ===========================================================================
# US Pizza POS Uptime Monitor — Telegraf agent for one Windows device (POS / KDS / SOK)
# Outlet: {{OUTLET_CODE}} {{OUTLET_NAME}} — this device: {{STATION}}
#
# Every minute: checks this device's app is running (and, on the POS, pings the ODS TV).
# Sends only when something CHANGED, plus an "I'm alive" refresh every 5 min.
# ===========================================================================

[global_tags]
  outlet_code = "{{OUTLET_CODE}}"
  channel = "{{CHANNEL}}"      # pos | kds | kiosk
  station = "{{STATION}}"      # POS-1 / KDS-1 / SOK-1 — must match the station in Supabase

[agent]
  interval = "1m"
  round_interval = true
  flush_interval = "1m"
  flush_jitter = "5s"
  metric_batch_size = 100
  metric_buffer_limit = 1000
  omit_hostname = false
  logfile = "C:\\Program Files\\InfluxData\\telegraf\\telegraf.log"
  logfile_rotation_max_size = "5MB"
  logfile_rotation_max_archives = 2
  skip_processors_after_aggregators = true

# ---------------------------------------------------------------------------
# "I'm alive": a stable value, so after dedup it is only re-sent every 5 min
# ---------------------------------------------------------------------------
[[inputs.mem]]
  fieldinclude = ["total"]

# ---------------------------------------------------------------------------
# Is this device's app running?  procstat_lookup.running = number of processes (0 = down)
# Fill in the process name from Task Manager → Details (e.g. "PosApp.exe")
# ---------------------------------------------------------------------------
{{PROCSTAT_BLOCK}}

# ---------------------------------------------------------------------------
# ODS TV connected to this POS (it can't run an agent, so the POS pings it)
# ---------------------------------------------------------------------------
{{PING_BLOCKS}}

# Only pass values that changed; re-send unchanged values every 5 minutes
[[processors.dedup]]
  dedup_interval = "5m"

# ---------------------------------------------------------------------------
# Send to the US Pizza dashboard
# ---------------------------------------------------------------------------
[[outputs.http]]
  url = "{{DASHBOARD_URL}}/api/heartbeat"
  method = "POST"
  timeout = "10s"
  data_format = "json"
  use_batch_format = true
  json_timestamp_units = "1s"
  [outputs.http.headers]
    Content-Type = "application/json"
    Authorization = "Bearer {{TOKEN}}"
